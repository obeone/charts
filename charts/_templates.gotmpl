| Key | Type | Default | Description |
| --- | --- | --- | --- |
{{- range . }}
| {{ .Key | replace "|" "\\|" }} | {{ .Type }} | {{ default .AutoDefault .Default | trim | replace "|" "\\|" }} | {{ default .AutoDescription .Description | trim | replace "|" "\\|" }} |
{{- end }}
{{- end -}}

