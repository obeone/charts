{{/*
Shared README skeleton for every chart in this repository.

Each chart ships its own README.md.gotmpl that defines the chart-specific
blocks below and then renders "obeone.readme". Regenerate all READMEs from
the repository root with:

    helm-docs --chart-search-root=charts \
      --template-files=./_templates.gotmpl \
      --template-files=README.md.gotmpl

Per-chart blocks:
  custom.app            (required) short presentation of the application
  custom.link.app       (required) inline markdown link to the upstream app
  custom.link.image     (required) inline markdown link(s) to the container image(s)
  custom.lineage        (required) which common library the chart builds on;
                        point it at one of the lineage.* helpers below
  custom.links.extra    (optional) extra bullets for the links list; content
                        must start with a newline followed by "- "
  custom.prerequisites  (optional) extra bullets for the prerequisites list;
                        content must start with a newline followed by "- "
  custom.configuration  (optional) chart-specific notes and examples; content
                        must start with a blank line
  custom.upgrade.notes  (optional) chart-specific notes rendered at the top of
                        the Upgrading section, before the helm upgrade command
  custom.banner         (optional) short warning banner rendered right after
                        the chart title and badges, before the installation
*/}}

{{- define "custom.links.extra" -}}{{- end -}}
{{- define "custom.prerequisites" -}}{{- end -}}
{{- define "custom.configuration" -}}{{- end -}}
{{- define "custom.upgrade.notes" -}}{{- end -}}
{{- define "custom.banner" -}}{{- end -}}

{{- define "lineage.k8s-at-home" -}}
This chart is built on the [k8s-at-home common library](https://github.com/k8s-at-home/library-charts)
(v4). Most configuration keys (`image`, `env`, `service`, `ingress`,
`persistence`, ...) follow its schema, so the library supports more than what
is spelled out in `values.yaml`.
{{- end -}}

{{- define "lineage.bjw-s" -}}
This chart is built on the [bjw-s-labs common library](https://github.com/bjw-s-labs/helm-charts).
Most configuration keys (`controllers`, `service`, `ingress`, `persistence`,
...) follow its schema; see the [common library documentation](https://bjw-s-labs.github.io/helm-charts/docs/)
for everything it supports beyond what is spelled out in `values.yaml`.
{{- end -}}

{{/* Center the chart identity and link each badge to its reference. */}}
{{- define "obeone.header" -}}
<!-- markdownlint-disable MD034 -->
<h1 align="center">{{ .Name | html }}</h1>

<p align="center">{{ .Description | html }}</p>

<p align="center">
  <a href="https://github.com/obeone/charts/tree/main/charts/{{ .Name }}/Chart.yaml"><img src="https://img.shields.io/badge/chart-{{ .Version | replace "-" "--" | urlquery }}-7c3aed?style=flat-square" alt="Chart version: {{ .Version | html }}"></a>
{{- if .AppVersion }}
  <a href="https://artifacthub.io/packages/helm/obeone/{{ .Name }}"><img src="https://img.shields.io/badge/app-{{ .AppVersion | replace "-" "--" | urlquery }}-0284c7?style=flat-square" alt="Application version: {{ .AppVersion | html }}"></a>
{{- end }}
  <a href="https://artifacthub.io/packages/helm/obeone/{{ .Name }}"><img src="https://img.shields.io/endpoint?url=https://artifacthub.io/badge/repository/obeone&amp;style=flat-square" alt="Artifact Hub"></a>
  <a href="#verifying-the-chart-signature"><img src="https://img.shields.io/badge/provenance-GPG_signed-15803d?style=flat-square" alt="GPG signed chart"></a>
</p>
<!-- markdownlint-enable MD034 -->
{{- end -}}

{{/* Link to the shared sections, omitting an absent values reference. */}}
{{- define "obeone.navigation" -}}
<p align="center">
  <a href="#installation">Installation</a> &middot;
  <a href="#configuration">Configuration</a> &middot;
{{- if .Values }}
  <a href="#values">Values</a> &middot;
{{- end }}
  <a href="#upgrading">Upgrading</a> &middot;
  <a href="#verifying-the-chart-signature">Signature</a> &middot;
  <a href="#support">Support</a>
</p>
{{- end -}}

{{/* Escape literal pipes so shell commands and JSON stay inside table cells. */}}
