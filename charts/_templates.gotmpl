### {{ .Sections.DefaultSection.SectionName }}

{{ template "obeone.values.rows" .Sections.DefaultSection.SectionItems }}
{{- end }}
{{- else }}
{{ template "obeone.values.rows" .Values }}
{{- end }}
{{- end -}}

